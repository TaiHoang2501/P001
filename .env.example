# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Provider for the AI agent: openai | google (Gemini) | openrouter (any model, OpenAI-compatible gateway) | groq | anthropic (Claude)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-...   (https://console.anthropic.com; default model claude-opus-5-5)
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=sk-or-...   (https://openrouter.ai/keys; models are named "<vendor>/<model>")
# GROQ_API_KEY=gsk_...   (https://console.groq.com/keys)
# Optional model override (default: gpt-4o-mini for openai, gemini-flash-latest for google,
# openai/gpt-4o-mini for openrouter, openai/gpt-oss-120b for groq, claude-opus-5-5 for anthropic;
# pick a model that supports tool calling)
# MODEL_NAME=
# Answers when the main model fails (e.g. Gemini 503 "high demand"); default gemini-flash-lite-latest on google, "none" = off
# MODEL_FALLBACK_NAME=
# Put the fallback on another provider (empty = same as LLM_PROVIDER), e.g. Claude first, OpenRouter when it fails:
#   LLM_PROVIDER=anthropic  LLM_FALLBACK_PROVIDER=openrouter  MODEL_FALLBACK_NAME=google/gemini-3.8-flash
# LLM_FALLBACK_PROVIDER=
# Claude's thinking depth: low | medium | high | xhigh | max (empty = the model's default)
# LLM_EFFORT=
# LLM_TIMEOUT_SECONDS=45
# LLM_MAX_RETRIES=2

# ---- AI Agent ----
# Conversation memory: postgres (survives restarts; on Windows run uvicorn with --reload) | memory
# AGENT_MEMORY=postgres
# Minutes a viewing request waits for the seller before the agent sends the buyer alternatives
# AGENT_FOLLOWUP_MINUTES=60
# Let the model word follow-ups and reminders (falls back to fixed templates)
# AGENT_PERSONALIZE=true

# ---- Database ----
# PostgreSQL 15+ is required (no SQLite: the double-booking guard uses Postgres constraints)
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/bookingbot
# Optional; defaults to DATABASE_URL with "_test" appended to the DB name
# TEST_DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/bookingbot_test

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
# OTP login. OTP_PROVIDER=local: we make the codes, they only go to the server log (and the API response outside
# production) - no SMS. OTP_PROVIDER=firebase: Firebase Phone Auth makes, sends (SMS) and checks the code.
# Firebase setup: console.firebase.google.com -> project -> Authentication -> Sign-in method -> Phone (enable);
# Authentication -> Settings -> Authorized domains: add the frontend domain; Project settings -> General -> Web app
# gives the web API key. Demo phones can be added as "Phone numbers for testing" (fixed code, no SMS sent).
OTP_PROVIDER=local
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_WEB_API_KEY=AIza...
# Optional; default <project id>.firebaseapp.com
# FIREBASE_AUTH_DOMAIN=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=5
OTP_RATE_WINDOW_MINUTES=15

# Support phone shown in the buyer chat while an operator has the AI turned off (kill switch)
# SUPPORT_HOTLINE=1900xxxx

# ---- AI chat rate limits (each message is a model call; signed-in buyers per account, guests per IP) ----
# CHAT_MESSAGES_PER_MINUTE=10
# CHAT_MESSAGES_PER_HOUR=120
# GUEST_CHAT_MESSAGES_PER_MINUTE=6
# GUEST_CHAT_MESSAGES_PER_HOUR=40

# ---- Media (S3-compatible storage: Supabase Storage / Cloudflare R2 / AWS S3) ----
# Public URL prefix for media keys (empty = API returns the raw key), e.g.
#   Supabase: https://<ref>.supabase.co/storage/v1/object/public/property-media/
#   R2:       https://pub-<id>.r2.dev/
MEDIA_BASE_URL=
# Uploads are disabled until all of these are set
#   Supabase: https://<ref>.storage.supabase.co/storage/v1/s3   R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Supabase: the project region (e.g. ap-southeast-1); R2: auto
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket for photos/floor plans/videos; private bucket for ownership documents (signed URLs only)
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
MEDIA_SIGNED_URL_SECONDS=600

# ---- Background jobs ----
# Expire viewing holds after their window (and send reminders); run in-process every N seconds
JOBS_ENABLED=true
JOB_INTERVAL_SECONDS=60


# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Langfuse (traces of AI chat turns; empty = off) ----
# Project Settings -> API Keys. EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_SAMPLE_RATE=1.0

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# VITE_API_URL=http://localhost:8000
