# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Provider for the AI agent: openai | google (Gemini)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# GOOGLE_API_KEY=
# Optional model override (default: gpt-4o-mini for openai, gemini-flash-latest for google)
# MODEL_NAME=
# Answers when the main model fails (e.g. Gemini 503 "high demand"); default gemini-flash-lite-latest on google, "none" = off
# MODEL_FALLBACK_NAME=
# LLM_TIMEOUT_SECONDS=45
# LLM_MAX_RETRIES=2

# ---- AI Agent ----
# Conversation memory: postgres (survives restarts; on Windows run uvicorn with --reload) | memory
# AGENT_MEMORY=postgres
# Minutes a viewing request waits for the seller before the agent sends the buyer alternatives
# AGENT_FOLLOWUP_MINUTES=60
# Let the model word follow-ups and reminders (falls back to fixed templates)
# AGENT_PERSONALIZE=true

# ---- Database ----
# PostgreSQL 15+ is required (no SQLite: the double-booking guard uses Postgres constraints)
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/bookingbot
# Optional; defaults to DATABASE_URL with "_test" appended to the DB name
# TEST_DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/bookingbot_test

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
# OTP login (codes are logged, and returned by the API outside production, until an SMS/Zalo provider is chosen)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=5
OTP_RATE_WINDOW_MINUTES=15

# ---- Media (S3) ----
# Public URL prefix for media keys, e.g. https://dxxxx.cloudfront.net/ (empty = API returns the raw key)
MEDIA_BASE_URL=

# ---- Background jobs ----
# Expire viewing holds after their window (and send reminders); run in-process every N seconds
JOBS_ENABLED=true
JOB_INTERVAL_SECONDS=60


# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# VITE_API_URL=http://localhost:8000
